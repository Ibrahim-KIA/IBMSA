# Copy this file to ".env" and fill in real values.
# See docs/SETUP_GUIDE.md for exactly where to get each one.

# ---- Site ----
# The web address people will use to reach the registration page.
# While testing on your own computer, leave this as-is.
BASE_URL=http://localhost:3000
PORT=3000

# ---- Database (Supabase Postgres) ----
# From Supabase: Project Settings -> Database -> Connection string -> "URI" (use the "Transaction pooler" one)
DATABASE_URL=

# ---- How people pay ----
# "bank_transfer" = you confirm each payment by hand in /admin/ (works today,
#   no external account needed). "paystack" = automatic, but needs your
#   Paystack business verification to be approved first.
PAYMENT_METHOD=bank_transfer

# ---- Bank transfer details (only used when PAYMENT_METHOD=bank_transfer) ----
# Shown to every registrant on the payment page. Use the school's real
# receiving account — this is the same info you'd put on an invoice.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# ---- Paystack (only used when PAYMENT_METHOD=paystack) ----
# From Paystack: Settings -> API Keys & Webhooks
# Use the TEST keys (pk_test_..., sk_test_...) until you are ready to go live.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---- Resend (sends confirmation emails) ----
# From resend.com: API Keys
RESEND_API_KEY=
# The "From" address on confirmation emails, e.g. "IBM School <registrations@yourdomain.com>"
# Until you verify your own domain in Resend, use: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# ---- WhatsApp group (only shown after payment is confirmed) ----
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/FLFZW0zvIhYCNpJoqptmsS

# ---- Admin login ----
ADMIN_EMAIL=owner@ibmschool.example
# Generate this with: npm run hash-password -- "your-chosen-password"
ADMIN_PASSWORD_HASH=
# Any long random string, used to sign admin login sessions. Generate one at
# https://www.uuidgenerator.net/ or just mash the keyboard for 40+ characters.
ADMIN_JWT_SECRET=

# ---- Tutor portal ----
# Tutors get ONE shared secret link (no individual accounts) — anyone with
# this exact link can view and edit curriculum progress, so keep it private.
# Any long random string works; share the resulting link as:
#   https://your-site.com/tutor/?token=THIS_VALUE
TUTOR_ACCESS_TOKEN=
